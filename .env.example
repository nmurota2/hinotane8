# =====================================================================
#  hinotane 設定ファイル
#  このファイルを .env にコピーして、値を埋めてください。
#      cp .env.example .env
#  .env は .gitignore に入っているので Git には上がりません。
# =====================================================================

# ---------------------------------------------------------------------
# 1. J-Quants API（株価データ）  https://jpx-jquants.com
# ---------------------------------------------------------------------
# 【V2 を使う場合】ダッシュボードで発行した API キーを入れる（推奨）
JQUANTS_API_KEY=

# 【V1 を使う場合】上を空にして、こちらを埋める
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=

# ベース URL。V2 のダッシュボードに .../v2 と書かれていたら末尾を v2 に変える
JQUANTS_BASE_URL=https://api.jquants.com/v1

# ---------------------------------------------------------------------
# 2. LINE Messaging API（通知・承認）  https://developers.line.biz
#    ※ LINE Notify は 2025/3/31 に終了済み。Messaging API を使う。
# ---------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 通知先かつ承認を許可する userId（U で始まる 33 文字）。カンマ区切りで複数可。
# 取得場所: LINE Developers コンソール →「チャネル基本設定」タブ → 一番下の
#           「あなたのユーザーID」
# 見つからない場合: ここを空のまま `hinotane serve` を起動して Bot に話しかけると、
#                   返信で userId を教えてくれます（セットアップモード）。
#                   その状態では承認操作を一切受け付けないので安全です。
LINE_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------
# 3. リスク管理  ★ここが実質的な安全装置。必ず自分の資金に合わせて変える★
# ---------------------------------------------------------------------
# 運用資金（円）
RISK_EQUITY_JPY=1000000
# 1トレードで失ってよい割合。0.01 = 1%（＝上記なら 1万円）
RISK_PER_TRADE=0.01
# 1銘柄に投じる上限（運用資金に対する割合）
RISK_MAX_POSITION_PCT=0.20
# 同時に保有できる最大銘柄数
RISK_MAX_OPEN_POSITIONS=5
# 1日に通知・発注してよい最大シグナル数
RISK_MAX_SIGNALS_PER_DAY=3
# 累計ドローダウンがこの割合に達したら全停止（キルスイッチ）
RISK_KILL_SWITCH_DRAWDOWN_PCT=0.15
# 承認の有効期限（時間）。これを過ぎた承認は執行されない
RISK_APPROVAL_TTL_HOURS=18

# ---------------------------------------------------------------------
# 4. スクリーニング条件
# ---------------------------------------------------------------------
# 使う戦略。カンマ区切り。breakout / pullback / reversal
SCREENER_STRATEGIES=breakout,pullback,reversal
# 20日平均売買代金の下限（円）。薄い銘柄は約定しないので必ず切る
SCREENER_MIN_TURNOVER_JPY=100000000
SCREENER_MIN_PRICE=300
SCREENER_MAX_PRICE=20000
# 対象市場 0111=プライム 0112=スタンダード 0113=グロース
SCREENER_MARKET_CODES=0111,0112

# ---------------------------------------------------------------------
# 5. 執行  ★★ ここを変えると実際にお金が動きます ★★
# ---------------------------------------------------------------------
# false のあいだは何をしても擬似発注。実運用の準備が整うまで false のまま。
LIVE_TRADING=false
# paper（擬似発注）/ tachibana（立花証券 e支店・Phase 4 で実装）
BROKER=paper
# true にすると LINE の承認を待たずに自動発注する。既定は false。
AUTO_EXECUTE_WITHOUT_APPROVAL=false
# 約定価格の想定スリッページ（片道）
EXEC_SLIPPAGE_PCT=0.002
# 売買手数料の想定（片道・率）
EXEC_COMMISSION_PCT=0.0005

# ---------------------------------------------------------------------
# 6. その他
# ---------------------------------------------------------------------
DB_PATH=./data/hinotane.duckdb
LOG_LEVEL=INFO
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# 株価データがこの日数より古かったら通知に警告を出す
STALE_DATA_WARN_DAYS=5
